{% extends '_layouts/base' %}

{% import '_includes/forms.twig' as forms %}

{% set bodyClass = 'content-freeze' %}
{% set title = heading %}

{% block body %}
  <div id="content-freeze-notice" class="pane">
    <div class="readable">
      <h1>
        {{ heading }}
      </h1>

      <p>
        {{ text }}
      </p>

      <div class="buttons">
        <div class="flex mb-0">
          {% set linkText = 'Continue'|t('content-freeze') %}
          {{ tag('a', {
            class: ['btn', 'submit'],
            href: cpUrl(''),
            text: linkText,
            aria: {label: linkText},
          }) }}
        </div>
      </div>
    </div>
  </div>
{% endblock %}

{% css %}
  html {
    height: 100%;
  }

  body.content-freeze {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 100%;
    padding: var(--padding);
  }

  body.content-freeze #content-freeze-notice {
    display: flex;
    flex-direction: row;
    max-width: 50em;
  }

  body.content-freeze #content-freeze-notice .buttons {
    justify-content: space-between;
  }
{% endcss %}
